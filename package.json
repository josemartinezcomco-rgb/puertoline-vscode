{
  "name": "puertoline",
  "displayName": "Puertoline",
  "description": "Agente de IA en VS Code para programación, diseño, marketing digital y creación de contenido: edita tu proyecto, usa skills expertas, se integra por MCP/APIs y funciona gratis con Ollama y respaldo automático entre modelos.",
  "version": "0.4.0",
  "publisher": "josemartinez",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "puertoline",
          "title": "Puertoline",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "puertoline": [
        {
          "type": "webview",
          "id": "puertoline.chat",
          "name": "Agente"
        }
      ]
    },
    "commands": [
      {
        "command": "puertoline.setApiKey",
        "title": "Puertoline: Configurar API key"
      },
      {
        "command": "puertoline.newChat",
        "title": "Puertoline: Nueva conversaciÃ³n",
        "icon": "$(add)"
      },
      {
        "command": "puertoline.focus",
        "title": "Puertoline: Abrir agente"
      },
      {
        "command": "puertoline.mcpStatus",
        "title": "Puertoline: Servidores MCP",
        "icon": "$(plug)"
      },
      {
        "command": "puertoline.mcpConfig",
        "title": "Puertoline: Editar configuraciÃ³n MCP (.mcp.json)"
      },
      {
        "command": "puertoline.mcpReload",
        "title": "Puertoline: Reconectar servidores MCP"
      },
      {
        "command": "puertoline.models",
        "title": "Puertoline: Modelos y respaldo"
      },
      {
        "command": "puertoline.addModel",
        "title": "Puertoline: AÃ±adir modelo"
      },
      {
        "command": "puertoline.pullOllama",
        "title": "Puertoline: Descargar modelo de Ollama"
      },
      {
        "command": "puertoline.skills",
        "title": "Puertoline: Skills"
      },
      {
        "command": "puertoline.installSkills",
        "title": "Puertoline: Instalar skills desde GitHub"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "puertoline.newChat",
          "when": "view == puertoline.chat",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "puertoline.focus",
        "key": "ctrl+alt+d",
        "mac": "cmd+alt+d"
      }
    ],
    "configuration": {
      "title": "Puertoline",
      "properties": {
        "puertoline.models": {
          "type": "array",
          "order": 0,
          "markdownDescription": "**Cadena de modelos, en orden de preferencia.** Si un modelo falla (lÃ­mite de uso, caÃ­da, timeout, no soporta herramientasâ€¦) el agente pasa al siguiente sin interrumpir la tarea, y vuelve al principal cuando se recupera. Las entradas cuyo proveedor necesita API key y no la tiene se omiten.\n\n`model: \"*\"` = todos los modelos instalados (Ollama) Â· `\"*free*\"` = todos los gratuitos con herramientas (OpenRouter).\n\nProveedores: `ollama`, `openrouter`, `gemini`, `groq`, `cerebras`, `mistral`, `github`, `deepseek`, `custom` (requiere `baseUrl`).",
          "default": [
            {
              "provider": "ollama",
              "model": "*"
            },
            {
              "provider": "openrouter",
              "model": "*free*"
            },
            {
              "provider": "gemini",
              "model": "gemini-flash-latest"
            },
            {
              "provider": "groq",
              "model": "openai/gpt-oss-120b"
            },
            {
              "provider": "cerebras",
              "model": "gpt-oss-120b"
            },
            {
              "provider": "mistral",
              "model": "mistral-small-latest"
            },
            {
              "provider": "github",
              "model": "openai/gpt-4.1-mini"
            },
            {
              "provider": "deepseek",
              "model": "deepseek-chat"
            }
          ],
          "items": {
            "type": "object",
            "required": [
              "provider",
              "model"
            ],
            "properties": {
              "provider": {
                "type": "string",
                "enum": [
                  "ollama",
                  "openrouter",
                  "gemini",
                  "groq",
                  "cerebras",
                  "mistral",
                  "github",
                  "deepseek",
                  "custom"
                ]
              },
              "model": {
                "type": "string"
              },
              "baseUrl": {
                "type": "string",
                "description": "Sobrescribe la URL del proveedor (obligatorio en custom)"
              },
              "keyName": {
                "type": "string",
                "description": "Nombre de la API key a usar (para varios custom)"
              },
              "disabled": {
                "type": "boolean"
              }
            }
          }
        },
        "puertoline.timeoutSeconds": {
          "type": "number",
          "default": 90,
          "description": "Si un modelo en la nube no responde en este tiempo, se pasa al siguiente."
        },
        "puertoline.localTimeoutSeconds": {
          "type": "number",
          "default": 300,
          "description": "Igual para Ollama (mÃ¡s alto: cargar el modelo en memoria puede tardar)."
        },
        "puertoline.ollamaContextLength": {
          "type": "number",
          "default": 32768,
          "description": "Ventana de contexto (num_ctx) para Ollama. Ollama usa un valor pequeÃ±o por defecto que corta conversaciones de agente; bÃ¡jalo si tu equipo se queda sin memoria."
        },
        "puertoline.autoApproveEdits": {
          "type": "boolean",
          "default": false,
          "description": "Aplicar cambios a archivos sin pedir confirmaciÃ³n."
        },
        "puertoline.autoApproveCommands": {
          "type": "boolean",
          "default": false,
          "description": "Ejecutar comandos de terminal sin pedir confirmaciÃ³n (Â¡cuidado!)."
        },
        "puertoline.autoApproveMcp": {
          "type": "boolean",
          "default": false,
          "description": "Ejecutar herramientas de servidores MCP sin pedir confirmaciÃ³n (tambiÃ©n se puede marcar cada servidor con \"trust\": true)."
        },
        "puertoline.autoApproveHttp": {
          "type": "boolean",
          "default": false,
          "description": "Permitir peticiones HTTP (http_request) sin pedir confirmaciÃ³n."
        },
        "puertoline.mcpServers": {
          "type": "object",
          "default": {},
          "markdownDescription": "Servidores MCP globales (para todos los proyectos). Mismo formato que `.mcp.json` de Claude Code:\n```json\n\"github\": { \"command\": \"npx\", \"args\": [\"-y\", \"@modelcontextprotocol/server-github\"], \"env\": { \"GITHUB_TOKEN\": \"${env:GITHUB_TOKEN}\" } },\n\"remoto\": { \"type\": \"http\", \"url\": \"https://.../mcp\", \"headers\": { \"Authorization\": \"Bearer ...\" } }\n```\nTambiÃ©n se leen `.mcp.json` y `.vscode/mcp.json` del proyecto.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "stdio",
                  "http",
                  "sse"
                ]
              },
              "command": {
                "type": "string"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "cwd": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "headers": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "trust": {
                "type": "boolean",
                "description": "No pedir confirmaciÃ³n para sus herramientas"
              },
              "disabled": {
                "type": "boolean"
              }
            }
          }
        },
        "puertoline.maxSteps": {
          "type": "number",
          "default": 40,
          "description": "MÃ¡ximo de pasos (llamadas a herramientas) por mensaje."
        },
        "puertoline.commandTimeoutSeconds": {
          "type": "number",
          "default": 120,
          "description": "Tiempo mÃ¡ximo de ejecuciÃ³n de un comando."
        },
        "puertoline.disabledSkills": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Nombres de skills que no se ofrecen al agente (útil con modelos locales pequeños para ahorrar contexto)."
        },
        "puertoline.includeClaudeSkills": {
          "type": "boolean",
          "default": false,
          "description": "Cargar también las skills personales de Claude Code (~/.claude/skills). Algunas dependen de conectores exclusivos de Claude."
        }
      }
    }
  },
  "scripts": {
    "typecheck": "tsc -p ./ --noEmit",
    "compile": "npm run typecheck && esbuild src/extension.ts --bundle --platform=node --target=node20 --format=cjs --external:vscode --outfile=out/extension.js --sourcemap",
    "watch": "esbuild src/extension.ts --bundle --platform=node --target=node20 --format=cjs --external:vscode --outfile=out/extension.js --sourcemap --watch",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "keywords": [
    "ai",
    "agent",
    "ollama",
    "deepseek",
    "mcp",
    "skills",
    "openrouter",
    "marketing",
    "seo",
    "design"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/josemartinezcomco-rgb/puertoline-vscode.git"
  },
  "homepage": "https://github.com/josemartinezcomco-rgb/puertoline-vscode#readme",
  "bugs": {
    "url": "https://github.com/josemartinezcomco-rgb/puertoline-vscode/issues"
  }
}
